---
import "../styles/global.css";

/* https://docs.astro.build/en/guides/view-transitions/ */
/* Astro creará animaciones de página predeterminadas basadas en las similitudes entre la página anterior y la nueva, y también ofrecerá un comportamiento alternativo para navegadores no compatibles. Es una forma de transportar elementos HTML de la página actual a la siguiente durante la navegación */
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>

    <!-- Al usar <ClientRouter /> en una página, la precarga (prefetch) también se activará de forma predeterminada. Se puede personalizar la configuración de precarga "astro.config.mjs" para anular la config predeterminada -->
    <ClientRouter />
  </head>

  <body>
    <div>
      <!-- en "<slot />" se renderizan cada una de nuestras páginas -->
      <slot />
    </div>
  </body>
</html>
