---
import Layout from "@layouts/Layout.astro";
/* para leer variables de entorno en el "servidor" (la parte superior de cada archivo, porque la parte inferior se considera la parte del "cliente") es colocarlo de forma directa */
import { SHOW_BUY_BUTTON } from "astro:env/server";
import { getCollection, render } from "astro:content";
import { formatDateUTC } from "@utils/formatDateUTC";
import BookScore from "@components/BookScore.astro";
import BuyButton from "@components/BuyButton.astro";

export async function getStaticPaths() {
  const booksCollection = await getCollection("books");

  /* se tiene que retornar un arreglo con la información que queremos que tenga cada ruta, en este caso, dentro de los parámetros (params) está el id que sería el slug de cada libro y dentro de las propiedades que se recibe (props) está la información del libro como tal */
  return booksCollection.map((book) => {
    return {
      params: { id: book.slug },
      props: { book },
    };
  });
}

/* aquí se pueden usar las variables desestructuradas que vienen de las props */
const { book } = Astro.props;
const { data, slug } = book;
const { title, author, img, readtime, description, buy, pubDate } = data;

const pubDateFormatted = formatDateUTC(pubDate);

/* para renderizar el contenido de la colección, en este caso de los archivos markdown, podemos usar el método "render" de Astro */
const { Content } = await render(book);

/* aquí también se tiene la directiva para que siga siendo una página estática al hacer el build pero tendrá cierto contenido dinámico que se generará desde el lado del servidor con los -- server:defer -- */
export const prerender = true;
---

<Layout>
  <div class="flex flex-col gap-4">
    <a href="/" class="hover:underline opacity-70">← Volver atrás</a>

    <div class="flex gap-12">
      <aside class="flex flex-col items-center gap-4">
        <!-- se está agregando una transición personalizada con el -- transition:name={`img-${slug}`} -- entre dos elementos de páginas diferentes para que al hacer la navegación pueda tener una transición fluida -->
        <img
          transition:name={`img-${slug}`}
          class="rounded w-72 h-auto"
          src={`/${img}`}
          alt={title}
        />

        <!-- las "islas de servidor" o las "server islands" (https://docs.astro.build/en/guides/server-islands/) son componentes que se renderizan en el servidor y que cuando están listos recién los devuelve al cliente, pero ya devuelve lo que renderiza, no hace el fetching de datos en el cliente pero para poder utilizarlas hay que hacer ciertas configuraciones, como instalar y configurar un adapter de servidor, en este caso será con "npm install @astrojs/node" pero si se va a desplegar en Vercel, Netlify, etc., hay que instalar el adapter correspondiente (@astrojs/vercel, @astrojs/netlify, etc.) -->
        <BookScore server:defer id={slug}>
          <!-- este componente vendría a ser un "fallback" que sirve para mostrar un mensaje mientras se carga el componente que queremos, sería algo similar a un Suspense y lazy loading de React. Para que funcione correctamente, hay que asegurarse de que el componente tenga -- slot="fallback" -- en sus atributos -->
          <span slot="fallback" class="text-sm text-gray-400 italic">
            Cargando puntuación...
          </span>
        </BookScore>

        <!-- NOTA: Cada isla se carga de forma independiente. Esto significa que una isla más lenta no retrasará la disponibilidad del resto de tu contenido personalizado -->
        {SHOW_BUY_BUTTON && <BuyButton server:defer buy={buy} />}
      </aside>

      <main class="max-w-3xl flex flex-col gap-3">
        <!-- se está agregando una transición personalizada con el -- transition:name={`title-${slug}`} -- entre dos elementos de páginas diferentes para que al hacer la navegación pueda tener una transición fluida -->
        <h1 transition:name={`title-${slug}`} class="text-4xl font-bold">
          {title}
        </h1>

        <div class="flex flex-col gap-0.5 border-b border-gray-700 pb-2 mb-2">
          <p class="text-sm text-gray-400 italic">
            <strong>Autor:</strong>
            {author}
          </p>

          <p class="text-sm text-gray-400 italic">
            <strong>Descripción:</strong>
            {description}
          </p>

          <p class="text-sm text-gray-400 italic">
            <strong>Tiempo de lectura:</strong>
            {readtime} minutos
          </p>

          <p class="text-sm text-gray-400 italic">
            <strong>Publicado:</strong>
            {pubDateFormatted}
          </p>
        </div>

        <div class="prose prose-invert">
          <Content />
        </div>
      </main>
    </div>
  </div>
</Layout>

<!-- algo bueno de Astro es que se pueden colocar estilos y scripts dentro de cada archivo o componente y solo tiene que afectar en donde se coloquen, a no ser que se coloque que sea un estilo global, por ejemplo -->

