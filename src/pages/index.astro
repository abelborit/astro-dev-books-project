---
import Layout from "../layouts/Layout.astro";
// leer la colección que estamos creando
import { getCollection } from "astro:content";

// Get all entries from a collection.
// Requires the name of the collection as an argument.
// NOTA: si ya cambiamos y ajustamos el nombre correctamente en "content.config.ts" pero sigue apareciendo error de que no encuentra la colección, puede ser que se haya quedado algo en caché, entonces tenemos que apagar la terminal, luego correr "rm -rf .astro" o solo eliminar el folder ".astro" y luego volver a correr "npm run dev" para que se regenere todo

// const booksCollection = await getCollection("books");
// console.log({ booksCollection });

const booksCollection = (await getCollection("books")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
  <main>
    <h1 class="text-center text-7xl font-extrabold mb-10">
      Dev 👨‍💻<span class="block">Books</span>
    </h1>

    <section aria-label="Libros recomendados para programadores">
      <div class="px-4 mx-auto max-w-4xl">
        <div class="grid gap-6 md:grid-cols-2 mt-5">
          {
            booksCollection.map((book) => {
              const { data, slug } = book;
              const {
                author,
                buy,
                description,
                img,
                readtime,
                title,
                pubDate,
              } = data;
              /* se está usando "getUTCDate()" - "getUTCMonth()" - "getUTCFullYear()" para obtener la fecha real del Markdown porque usar los métodos "getDate()" - "getMonth()" - "getFullYear()" de JavaScript usan la fecha en la zona horaria local del servidor, pero Astro parsea las fechas en UTC (por ejemplo, 2024-04-22T00:00:00.000Z es medianoche UTC). Si tu zona horaria está detrás de UTC (por ejemplo, UTC-6), el método "getDate()" puede devolver el día anterior */
              const pubDateFormatted = `${pubDate.getUTCDate().toString().padStart(2, "0")}/${(pubDate.getUTCMonth() + 1).toString().padStart(2, "0")}/${pubDate.getUTCFullYear()}`;

              return (
                <article class="flex gap-3 border-2 border-gray-400 rounded-xl p-6 relative h-64 transition-transform hover:scale-95">
                  <a
                    href={`/libro/${slug}`}
                    class="xl:mb-0 transition flex justify-start gap-5"
                  >
                    <div class="w-52 h-full rounded flex justify-center items-start">
                      <img
                        transition:name={`img-${slug}`}
                        class="w-full h-full rounded"
                        src={`/${img}`}
                        alt={title}
                      />
                    </div>

                    <div class="flex flex-col justify-start ">
                      <h2
                        transition:name={`title-${slug}`}
                        class="mb-0.5 text-2xl font-bold leading-tight text-white"
                      >
                        {title}
                      </h2>

                      <span class="mb-0.5 text-sm italic text-gray-400">
                        - {author} -
                      </span>

                      <span class="mb-3 text-xs italic text-gray-400">
                        {pubDateFormatted}
                      </span>

                      <p class="mb-4 text-gray-300 max-w-sm text-sm">
                        {description}
                      </p>
                    </div>

                    <span class="text-xs absolute bottom-6 right-6 italic text-gray-400">
                      ⏳ Lectura en {readtime} minutos
                    </span>
                  </a>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
