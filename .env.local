# como se tiene un -- default: true, -- en "astro.config.mjs" entonces no sería necesario colocar la variable de entorno aquí solo si se quiere desactivar el botón de compra que se pondría como "false"
SHOW_BUY_BUTTON="true"

# esta es una api que solo da un número random entre 1 y 5
SCORE_API_ENDPOINT="https://www.random.org/integers/?num=1&min=1&max=5&col=1&base=10&format=plain&rnd=new"